{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bizflow-api",
	"main": "src/index.ts",
	"compatibility_date": "2024-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bizflow-db",
			"database_id": "f6ce449c-aa8a-4e2d-9bbf-4ba7d5435dfb",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"FRONTEND_URL": "https://elanselvanbizflow.pages.dev"
	}
}